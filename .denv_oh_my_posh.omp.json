{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#b10065",
          "foreground": "#FEF5ED",
          "leading_diamond": "\ue0b6",
          "properties": {
            "macos": "\uf179",
            "ubuntu": "\uf31b",
            "windows": "\ue62a"
          },
          "style": "diamond",
          "template": "{{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "#b10065",
          "foreground": "#FEF5ED",
          "properties": {
            "style": "full",
            "home_icon": "home",
            "folder_icon": "\uf07b ",
            "folder_separator_icon": "\\"
          },
          "trailing_diamond": "\ue0b4",
          "style": "diamond",
          "template": "{{ .Path }}",
          "type": "path"
        },
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "background": "#740580",
          "foreground": "#FEF5ED",
          "trailing_diamond": "\ue0b4",
          "style": "diamond",
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} {{ .UpstreamIcon }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "background": "#F2C447",
          "foreground": "#011627",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "properties": {
            "time_format": "2006-01-02"
          },
          "template": "\uf274 {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b4",
          "type": "time"
        },
        {
          "background": "#F76218",
          "foreground": "#011627",
          "style": "diamond",
          "trailing_diamond": "\ue0b4",
          "properties": {
            "time_format": "15:04:05.0"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "type": "time"
        },
        {
          "background": "#FF1D68",
          "foreground": "#011627",
          "trailing_diamond": "\ue0b4",
          "properties": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": " \uf254 {{ .FormattedMs }}",
          "type": "executiontime"
        },
        {
          "background": "#FF1D68",
          "foreground": "#011627",
          "trailing_diamond": "\ue0b4",
          "style": "diamond",
          "template": "exit-code:{{ .Code }}",
          "type": "status"
        }
      ],
    "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#FEF5ED",
          "background": "#1931ab",
          "trailing_diamond": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\udb83\udc1c \udb82\udfec \udb83\udc1f \udb83\udc25 \ue234 \ueada \ue764 \udb85\udc84 \udb83\udf49 \uf437 ",
          "type": "shell"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#39Ff14",
          "style": "diamond",
          "template": " \uf4b5 {{ .UserName }} {{ if .Root }}#{{else}}${{ end }} ",
          "type": "shell"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ .Folder }}",
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#FEF5ED",
    "template": "\ue285 "
  },
  "version": 3
}
